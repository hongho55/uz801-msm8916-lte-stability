diff --git a/msm89xx/base-files/etc/uci-defaults/99-uz801-private-management b/msm89xx/base-files/etc/uci-defaults/99-uz801-private-management
new file mode 100755
index 0000000..a7d9d06
--- /dev/null
+++ b/msm89xx/base-files/etc/uci-defaults/99-uz801-private-management
@@ -0,0 +1,20 @@
+#!/bin/sh
+# Private UZ801 settings, after 99-msm89xx-firstboot.
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'yiming,uz801-v3' ] || exit 0
+# EXPERIMENT: exact-board NV2500 opt-in; no automatic data/recovery.
+uci -q batch <<'EOF'
+set network.modem.auto='0'
+set network.@device[0].bridge_empty='1'
+set usbgadget.ecm.enabled='1'
+set usbgadget.ncm.enabled='0'
+set usbgadget.acm.enabled='1'
+set usbgadget.acm.shell='1'
+set modem-watchdog.recovery.himi_ok_boards='yiming,uz801-v3'
+set modem-watchdog.recovery.himi_ok_enabled='1'
+set modem-watchdog.recovery.himi_ok_interval='20'
+set modem-watchdog.general.enabled='0'
+commit network
+commit usbgadget
+commit modem-watchdog
+EOF
+exit 0
diff --git a/msm89xx/base-files/lib/himi-ok.sh b/msm89xx/base-files/lib/himi-ok.sh
index f740924..315ed1c 100644
--- a/msm89xx/base-files/lib/himi-ok.sh
+++ b/msm89xx/base-files/lib/himi-ok.sh
@@ -31,7 +31,9 @@ himi_ok_board_match() {
 	bn="${1:-$(board_name 2>/dev/null)}"
 	[ -n "$bn" ] || return 1
 	list="$(uci -q get modem-watchdog.recovery.himi_ok_boards 2>/dev/null)"
-	[ -n "$list" ] || list="*hmu05* *hmuf02v5* *uz801* *uf02*"
+	# UZ801 is deliberately NOT in this private-build default: the exact HIMI_U01_MODEM_V2.0 unit has no
+	# verified NV-2500 predicate, so no unattended NV write is baked in. Opt in via the uci list below.
+	[ -n "$list" ] || list="*hmu05* *hmuf02v5* *uf02*"
 	# Match bn against each space-separated glob.  Disable pathname expansion
 	# in a subshell, otherwise the unquoted $list is glob-expanded against the
 	# CWD and a file like "hmu05_fsg_extracted" would replace the pattern.
