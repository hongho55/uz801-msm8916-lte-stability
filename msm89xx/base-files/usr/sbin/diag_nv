#!/bin/sh
#
# diag_nv - read or write a modem NV item BY ID over the SMD DIAG channel.
#
# The implementation is the static aarch64 binary /usr/libexec/diag_nv.bin;
# this wrapper exists to provide a real --help and to keep the binary out of
# the command namespace.
#
case "${1:-}" in
	-h|--help)
		cat <<'USAGE'
Usage: diag_nv {read <item> | write <item> <hexbytes> | raw <hexbytes>}
       diag_nv -h|--help

Read or write a modem NV item BY ID over the SMD DIAG channel (/dev/rpmsg0),
using DIAG commands 0x26 (NV_READ_F) and 0x27 (NV_WRITE_F).  This is the raw NV
path, not EFS: use it for items that are not exposed under /nv/item_files.

Commands:
  read  <item>          Print the item contents as hex
  write <item> <hex>    Write up to 128 bytes, then read back and compare
  raw   <hexbytes>      Send arbitrary DIAG bytes and print the reply

Arguments:
  <item>       NV item number, decimal or 0x-prefixed
  <hexbytes>   hex string without separators
               (e.g. 48694d495f4f4b = "HiMI_OK")

Options:
  -h, --help   Show this help and exit

Notes:
  * This wrapper serializes on /var/lock/himi-ok-diag.lock and preserves
    the guard's inherited lock across its read/check/write cycle.
    Direct binary/raw DIAG callers must honor the same lock.
  * Reply byte 0x14 = "invalid parameter"; status 0x42 = NV locked by the
    service programming state.

Requires the DIAG bridge: run 'diag-bind' first (or the diag-bind service).

Examples:
  diag_nv read 2500
  diag_nv write 2500 48694d495f4f4b
USAGE
		exit 0
		;;
esac

# Reuse the guard's open-file description rather than opening a second one
# and deadlocking against our parent. Never trust an environment-only bypass.
DIAG_LOCK=/var/lock/himi-ok-diag.lock
if ! [ /proc/self/fd/200 -ef "$DIAG_LOCK" ]; then
	exec 200>"$DIAG_LOCK"
fi
flock -x 200 || exit 1
# No explicit unlock: exec/exit closes our reference; a parent guard keeps its
# inherited reference locked until the whole guarded transaction completes.
exec /usr/libexec/diag_nv.bin "$@"
